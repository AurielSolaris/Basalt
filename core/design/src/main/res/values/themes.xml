<?xml version="1.0" encoding="utf-8"?>
<!--
  The window theme.

  It lives in :core:design rather than :app because the alarm activity is
  declared in :feature:alarm, and a library manifest can only reference
  resources it can actually see. Keeping the theme beside the palette it
  matches is the right home for it anyway.
-->
<resources>
    <style name="Theme.Basalt" parent="android:Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@color/ink</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
