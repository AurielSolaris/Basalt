# Copy to keystore.properties and fill in. Never commit the filled-in copy.
#
# Generate a keystore with:
#   keytool -genkeypair -v -keystore keystore/basalt-release.jks -alias basalt \
#           -keyalg RSA -keysize 4096 -validity 10000
#
# CI can skip this file and set BASALT_KEYSTORE, BASALT_KEYSTORE_PASSWORD,
# BASALT_KEY_ALIAS and BASALT_KEY_PASSWORD instead.
storeFile=keystore/basalt-release.jks
storePassword=
keyAlias=basalt
keyPassword=
