<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>

        <!--
          The ten providers.

          A widget provider is a BroadcastReceiver named in the manifest, which
          the package installer reads long before any Basalt code runs — so the
          one place the catalogue cannot stay a list is here and in the classes
          these point at. Each is a name and nothing else; all ten share one
          implementation.

          exported="false" throughout: the launcher binds these through the
          AppWidgetHost, which does not need them exported, and an exported
          receiver is a surface for no benefit.
        -->
        <receiver
            android:name=".glance.AnalogWidgetReceiver"
            android:label="@string/widget_analog_label"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_analog" />
        </receiver>

