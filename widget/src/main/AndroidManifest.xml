        <!--
          The single update pass.

          One receiver draws every installed widget and then schedules its own
          successor, so a home screen with six Basalt widgets on it wakes the
          device once a minute rather than six times.

          The system broadcasts matter more than they look. A time-zone change
          moves every world and dual face at once and none of them would notice
          until the minute turned; a locale change re-renders every date line;
          and BOOT_COMPLETED is what puts the pass back on the calendar at all,
          since a pending alarm does not survive a restart.
        -->
        <receiver
            android:name=".update.WidgetTickReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="app.auriel.basalt.widget.TICK" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.LOCALE_CHANGED" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
